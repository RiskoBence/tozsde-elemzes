---
import Base from '../layouts/Base.astro';
import { osszesNap } from '../lib/napok';
import { haviBontas, osszesites, tradeEredmeny } from '../lib/statisztika';
import { datumRovid, honapNeve } from '../lib/format';
import { huSzam } from '../lib/szam';
import { url } from '../lib/url';

const napok = await osszesNap();
const o = osszesites(napok);
const havi = haviBontas(napok);
const utolsoTradek = [...o.tradek].reverse().slice(0, 20);

const szazalek = (x: number | null) => (x === null ? '–' : `${huSzam(x * 100, 0)}%`);
const elojeles = (x: number, tizedes = 1) => huSzam(x, tizedes, true);
const tonus = (x: number | null) => (x === null || x === 0 ? '' : x > 0 ? 'text-ok' : 'text-bad');

const kpi = [
  { cim: 'Trade-ek', ertek: String(o.tradek.length), alt: `${o.nyero} nyerő · ${o.veszto} vesztő${o.nullas ? ` · ${o.nullas} BE` : ''}` },
  { cim: 'Win rate', ertek: szazalek(o.winRate), alt: 'BE nélkül' },
  { cim: 'Összes R', ertek: elojeles(o.osszR), alt: o.atlagR === null ? '' : `átlag ${elojeles(o.atlagR, 2)} R`, t: tonus(o.osszR) },
  { cim: 'Összes USD', ertek: elojeles(o.osszUsd, 2), alt: '', t: tonus(o.osszUsd) },
  { cim: 'Szabálykövetés', ertek: szazalek(o.szabalyArany), alt: 'a kitöltött trade-ekből' },
  { cim: 'Max visszaesés', ertek: o.maxVisszaesesR ? `−${huSzam(o.maxVisszaesesR, 1)} R` : '0 R', alt: 'kumulált R csúcsról' },
];
const setupSor = [
  { cim: 'VAN SETUP', db: o.setup.VAN, t: 'text-ok' },
  { cim: 'Feltételes terv', db: o.setup.FELTETELES, t: 'text-warn' },
  { cim: 'NINCS SETUP', db: o.setup.NINCS, t: 'text-bad' },
  { cim: 'Nincs döntés', db: o.setup.nincsAdat, t: 'text-muted' },
].filter((s) => s.db > 0);
const cimke = 'text-xs font-medium uppercase tracking-wider text-muted';
---

<Base title="TECH100 – statisztika" aktiv="statisztika">
  <h1 class="text-xl font-semibold">Statisztika</h1>

  {
    napok.length === 0 ? (
      <p class="card mt-4 text-muted">Még nincs elemzés, így statisztika sincs.</p>
    ) : (
      <div class="mt-4 grid grid-cols-1 gap-4">
        <section aria-label="Napok" class="card">
          <h2 class="font-semibold">Napok</h2>
          <p class="mt-1 text-sm text-muted">
            {o.napok} elemzett nap{o.pirosNapok > 0 && ` · ${o.pirosNapok} piros előszűréssel`}
          </p>
          <ul class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-4">
            {setupSor.map((s) => (
              <li class="rounded-xl border border-line px-3 py-2">
                <p class={cimke}>{s.cim}</p>
                <p class:list={['text-lg font-semibold', s.t]}>
                  {s.db} <span class="text-sm font-normal text-muted">({szazalek(s.db / o.napok)})</span>
                </p>
              </li>
            ))}
          </ul>
        </section>

        {o.tradek.length === 0 ? (
          <section class="card text-sm text-muted">
            <h2 class="font-semibold text-fg">Trade-ek</h2>
            <p class="mt-1">
              Még nincs kitöltött napló. A statisztika a <strong>## 8. Napló</strong> táblázat azon soraiból készül, ahol az Irány ki van töltve. Az Eredmény oszlop
              formája: <code class="font-mono">+1,8 USD / +2R</code>.
            </p>
          </section>
        ) : (
          <>
            <section aria-label="Trade-összesítés" class="grid grid-cols-2 gap-2 sm:grid-cols-3">
              {kpi.map((k) => (
                <div class="card">
                  <p class={cimke}>{k.cim}</p>
                  <p class:list={['mt-1 font-mono text-xl font-bold', k.t]}>{k.ertek}</p>
                  {k.alt && <p class="mt-0.5 text-xs text-muted">{k.alt}</p>}
                </div>
              ))}
            </section>

            <section aria-label="Havi bontás">
              <h2 class="mb-2 font-semibold">Havi bontás</h2>
              <div class="tabla-wrap rounded-2xl border border-line bg-panel">
                <table class="w-full min-w-max text-sm">
                  <thead class="bg-panel-2 text-left text-xs uppercase tracking-wider text-muted">
                    <tr>
                      <th class="px-3 py-2 font-medium">Hónap</th>
                      <th class="px-3 py-2 text-right font-medium">Nap</th>
                      <th class="px-3 py-2 text-right font-medium">Trade</th>
                      <th class="px-3 py-2 text-right font-medium">N / V</th>
                      <th class="px-3 py-2 text-right font-medium">R</th>
                      <th class="px-3 py-2 text-right font-medium">USD</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-line">
                    {havi.map((h) => (
                      <tr>
                        <td class="px-3 py-2 whitespace-nowrap">{honapNeve(h.honap)}</td>
                        <td class="px-3 py-2 text-right">{h.napok}</td>
                        <td class="px-3 py-2 text-right">{h.tradek}</td>
                        <td class="px-3 py-2 text-right">
                          {h.nyero} / {h.veszto}
                        </td>
                        <td class:list={['px-3 py-2 text-right font-mono', tonus(h.osszR)]}>{elojeles(h.osszR)}</td>
                        <td class:list={['px-3 py-2 text-right font-mono', tonus(h.osszUsd)]}>{elojeles(h.osszUsd, 2)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </section>

            <section aria-label="Utolsó trade-ek">
              <h2 class="mb-2 font-semibold">Utolsó trade-ek</h2>
              <ul class="divide-y divide-line overflow-hidden rounded-2xl border border-line bg-panel">
                {utolsoTradek.map((t) => {
                  const e = tradeEredmeny(t);
                  return (
                    <li>
                      <a href={url(`/nap/${t.datum}/`)} class="flex min-h-14 flex-wrap items-center gap-x-3 gap-y-1 px-4 py-3 hover:bg-panel-2">
                        <span class="min-w-0 flex-1 basis-44">
                          <span class="block text-sm font-medium">
                            {datumRovid(t.datum)} · {t.irany}
                            {t.szabaly === false && <span class="ml-1 text-xs font-semibold text-warn">⚠ szabályszegés</span>}
                          </span>
                          {t.tanulsag && <span class="block text-xs text-muted">{t.tanulsag}</span>}
                        </span>
                        <span class:list={['font-mono text-sm font-semibold', tonus(e)]}>{t.eredmeny || '–'}</span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </section>
          </>
        )}
      </div>
    )
  }
</Base>
