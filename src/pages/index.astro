---
import Base from '../layouts/Base.astro';
import Nap from '../components/Nap.astro';
import NapLapozo from '../components/NapLapozo.astro';
import { osszesNap } from '../lib/napok';
import { url } from '../lib/url';

const napok = await osszesNap();
const ma = napok[0];
---

<Base title="TECH100 – mai elemzés" aktiv="ma">
  {
    ma ? (
      <div class="grid grid-cols-1 gap-4">
        <h1 class="sr-only">Mai elemzés</h1>
        <Nap nap={ma} />
        <div class="flex flex-wrap items-center justify-between gap-2">
          <NapLapozo elozo={napok[1]?.datum ?? null} kovetkezo={null} />
          <a href={url(`/nap/${ma.datum}/`)} class="text-sm text-accent underline underline-offset-2">
            Állandó link ehhez a naphoz
          </a>
        </div>
      </div>
    ) : (
      <div class="card">
        <h1 class="text-lg font-semibold">Még nincs elemzés</h1>
        <p class="mt-2 text-muted">
          Tegyél egy <code class="font-mono">YYYY-MM-DD-valami.md</code> fájlt a <code class="font-mono">content/elemzesek/</code> mappába, és pushold.
        </p>
      </div>
    )
  }
</Base>
