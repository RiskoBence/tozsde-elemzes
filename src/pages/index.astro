---
import Base from '../layouts/Base.astro';
import Nap from '../components/Nap.astro';
import NapLapozo from '../components/NapLapozo.astro';
import MeretKalkulator from '../components/MeretKalkulator.astro';
import Diagram from '../components/Diagram.astro';
import { ALAP_ABLAK } from '../lib/parse-elemzes';
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
import { osszesNap } from '../lib/napok';
import { url } from '../lib/url';

const napok = await osszesNap();
const ma = napok[0];
// Elemzés nélkül is mutassuk a legfrissebb diagram-adatot (gépi szintekkel).
const adatFajl = join(process.cwd(), 'public', 'adat', 'nq.json');
const adatDatum: string | null = existsSync(adatFajl) ? JSON.parse(readFileSync(adatFajl, 'utf8')).datum : null;
---

<Base title="TECH100 – mai elemzés" aktiv="ma">
  {
    ma ? (
      <div class="grid grid-cols-1 gap-4">
        <h1 class="sr-only">Mai elemzés</h1>
        <Nap nap={ma} />
        <div class="flex flex-wrap items-center justify-between gap-2">
          <NapLapozo elozo={napok[1]?.datum ?? null} kovetkezo={null} />
          <a href={url(`/nap/${ma.datum}/`)} class="text-sm text-accent underline underline-offset-2">
            Állandó link ehhez a naphoz
          </a>
        </div>
      </div>
    ) : (
      <div class="grid grid-cols-1 gap-4">
        <div class="card">
          <h1 class="text-lg font-semibold">Még nincs elemzés</h1>
          <p class="mt-2 text-muted">
            Tegyél egy <code class="font-mono">YYYY-MM-DD-valami.md</code> fájlt a <code class="font-mono">content/elemzesek/</code> mappába, és pushold.
          </p>
        </div>
        {adatDatum && <Diagram azon="ures" datum={adatDatum} ablak={ALAP_ABLAK} szintek={[]} riasztasok={[]} figyeld={[]} />}
        <MeretKalkulator azon="ures" />
      </div>
    )
  }
</Base>
