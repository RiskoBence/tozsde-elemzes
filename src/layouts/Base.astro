---
import '../styles/global.css';
import { osszesNap } from '../lib/napok';
import { ALAP_ABLAK } from '../lib/parse-elemzes';
import { datumHosszu, napNeve } from '../lib/format';
import { url } from '../lib/url';

interface Props {
  title: string;
  aktiv?: 'ma' | 'archivum' | 'statisztika' | 'sablon' | null;
}

const { title, aktiv = null } = Astro.props;
const legutobbi = (await osszesNap())[0] ?? null;
const frissitve = legutobbi?.datum ?? null;
const menu = [
  { kulcs: 'ma', cim: 'Ma', href: url('/') },
  { kulcs: 'archivum', cim: 'Archívum', href: url('/archivum/') },
  { kulcs: 'statisztika', cim: 'Statisztika', rovid: 'Stat.', href: url('/statisztika/') },
] as const;
---

<!doctype html>
<html lang="hu" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content="Napi TECH100 (Nasdaq-100 CFD) price action elemzések, archívummal." />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0a0d12" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f4f5f7" media="(prefers-color-scheme: light)" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="TECH100" />
    <link rel="manifest" href={url('/manifest.webmanifest')} />
    <link rel="icon" href={url('/icon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <script is:inline>
      // Téma: a mentett választás, különben a rendszerbeállítás; ha az nem kér világosat, sötét.
      (function () {
        var t = null;
        try { t = localStorage.getItem('tema'); } catch (e) {}
        var sotet = t ? t === 'sotet' : !window.matchMedia('(prefers-color-scheme: light)').matches;
        document.documentElement.classList.toggle('dark', sotet);
      })();
    </script>
  </head>
  <body class="min-h-dvh">
    <a href="#tartalom" class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50 focus:rounded-lg focus:bg-panel focus:px-3 focus:py-2">
      Ugrás a tartalomra
    </a>
    <header class="sticky top-0 z-30 border-b border-line bg-bg/90 backdrop-blur supports-[backdrop-filter]:bg-bg/75">
      <div class="mx-auto flex max-w-3xl items-center gap-2 px-4 py-2">
        <a href={url('/')} class="flex min-h-11 items-center gap-2 font-semibold tracking-tight">
          <img src={url('/icon.svg')} alt="" width="24" height="24" class="hidden rounded-md sm:block" />
          <span>TECH100<span class="hidden font-normal text-muted sm:inline"> napló</span></span>
        </a>
        <nav aria-label="Fő navigáció" class="ml-auto flex items-center">
          {
            menu.map((m) => (
              <a
                href={m.href}
                aria-current={aktiv === m.kulcs ? 'page' : undefined}
                class:list={[
                  'flex min-h-11 items-center rounded-lg px-2 text-sm font-medium sm:px-3',
                  aktiv === m.kulcs ? 'text-fg bg-panel-2' : 'text-muted hover:text-fg',
                ]}
              >
                {'rovid' in m ? (
                  <>
                    <span class="sm:hidden" aria-hidden="true">{m.rovid}</span>
                    <span class="max-sm:sr-only">{m.cim}</span>
                  </>
                ) : (
                  m.cim
                )}
              </a>
            ))
          }
          <button
            id="tema-valto"
            type="button"
            class="ml-1 flex size-11 items-center justify-center rounded-lg text-muted hover:text-fg hover:bg-panel-2"
            aria-label="Téma váltása (sötét / világos)"
            title="Téma váltása"
          >
            <svg class="hidden size-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
            </svg>
            <svg class="size-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
            </svg>
          </button>
        </nav>
      </div>
      <div class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-x-3 gap-y-1 px-4 pb-1.5 text-xs text-muted">
        {
          frissitve && (
            <p>
              Frissítve:{' '}
              <time datetime={frissitve}>
                {datumHosszu(frissitve)} ({napNeve(frissitve)})
              </time>
            </p>
          )
        }
        <p
          id="ablak-allapot"
          data-ablak={legutobbi?.fo.ablak ?? ALAP_ABLAK}
          data-alap={ALAP_ABLAK}
          data-utolso={frissitve ?? ''}
          class="ml-auto flex flex-wrap items-center justify-end gap-x-2"
          aria-live="off"
          hidden
        >
        </p>
      </div>
    </header>

    <main id="tartalom" class="mx-auto max-w-3xl px-4 pb-10 pt-4">
      <slot />
    </main>

    <div
      id="masolas-uzenet"
      role="status"
      aria-live="polite"
      class="pointer-events-none fixed inset-x-0 bottom-6 z-40 mx-auto w-max max-w-[90vw] rounded-full bg-fg px-4 py-2 text-sm font-medium text-bg opacity-0 transition-opacity"
    >
    </div>

    <footer class="border-t border-line">
      <div class="mx-auto max-w-3xl px-4 py-6 text-sm text-muted">
        <p>A döntés és a felelősség a tiéd. Ez elemzés, nem befektetési tanács, és nem ígér profitot.</p>
        <p class="mt-3">
          <a href={url('/sablon/')} aria-current={aktiv === 'sablon' ? 'page' : undefined} class="inline-flex min-h-11 items-center underline underline-offset-2 hover:text-fg">
            Napi elemzési sablon
          </a>
        </p>
      </div>
    </footer>

    <script>
      import { ablakAllapot, budapestiIdo, idotartam } from '../lib/ablak';

      // --- Téma ---
      document.getElementById('tema-valto')?.addEventListener('click', () => {
        const sotet = !document.documentElement.classList.contains('dark');
        document.documentElement.classList.toggle('dark', sotet);
        try {
          localStorage.setItem('tema', sotet ? 'sotet' : 'vilagos');
        } catch {}
      });

      // --- Másolás koppintásra: bármely [data-masol] elem ---
      // A szóköz ezres elválasztó kimarad (a bróker beviteli mezője így fogadja), a tizedesvessző marad.
      // Ha pontot szeretnél: .replace(',', '.')
      const masolhato = (ar: string) => ar.replace(/[\s  ]/g, '');

      async function masol(szoveg: string): Promise<boolean> {
        try {
          await navigator.clipboard.writeText(szoveg);
          return true;
        } catch {
          const ta = document.createElement('textarea');
          ta.value = szoveg;
          ta.setAttribute('readonly', '');
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          const ok = document.execCommand('copy');
          ta.remove();
          return ok;
        }
      }

      let idozito: number | undefined;
      document.addEventListener('click', async (ev) => {
        const gomb = (ev.target as Element | null)?.closest<HTMLElement>('[data-masol]');
        if (!gomb?.dataset.masol) return;
        const szoveg = masolhato(gomb.dataset.masol);
        const ok = await masol(szoveg);
        const uzenet = document.getElementById('masolas-uzenet');
        if (!uzenet) return;
        uzenet.textContent = ok ? `Másolva: ${szoveg}` : 'A másolás nem sikerült';
        uzenet.style.opacity = '1';
        window.clearTimeout(idozito);
        idozito = window.setTimeout(() => (uzenet.style.opacity = '0'), 1600);
      });

      // --- Kereskedési ablak állapota (budapesti idő szerint, félpercenként frissül) ---
      const chip = document.getElementById('ablak-allapot');
      function frissit() {
        if (!chip) return;
        const ido = budapestiIdo();
        const maiElemzes = chip.dataset.utolso === ido.datum;
        const ablak = (maiElemzes ? chip.dataset.ablak : chip.dataset.alap) ?? '15:45–17:30';
        const a = ablakAllapot(ido, ablak);
        if (!a) return;

        let szoveg = '';
        let tonus = 'text-muted';
        if (a.tipus === 'hetvege') szoveg = 'Hétvége';
        else if (a.tipus === 'elotte') szoveg = `Ablak ${a.nyit}-kor nyit (${idotartam(a.hatra)} múlva)`;
        else if (a.tipus === 'nyitva') {
          szoveg = `● Ablak nyitva · zár ${a.zar} (${idotartam(a.hatra)})`;
          tonus = 'text-ok font-semibold';
        } else szoveg = 'Mai ablak lezárva';

        const hianyzik = a.tipus !== 'hetvege' && !maiElemzes;
        chip.replaceChildren(
          Object.assign(document.createElement('span'), { className: tonus, textContent: szoveg }),
          ...(hianyzik
            ? [Object.assign(document.createElement('span'), { className: 'text-warn font-semibold', textContent: '⚠ A mai elemzés még nincs feltöltve' })]
            : []),
        );
        chip.hidden = false;
      }
      frissit();
      window.setInterval(frissit, 30_000);
    </script>
  </body>
</html>
