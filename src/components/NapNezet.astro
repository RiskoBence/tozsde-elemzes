---
import type { Elemzes, TradeTerv } from '../lib/parse-elemzes';
import Osszkep from './Osszkep.astro';
import HetFigyelmeztetes from './HetFigyelmeztetes.astro';
import Kulcsszintek from './Kulcsszintek.astro';
import Diagram from './Diagram.astro';
import Forgatokonyvek from './Forgatokonyvek.astro';
import MeretKalkulator from './MeretKalkulator.astro';
import Checklist from './Checklist.astro';
import Szakaszok from './Szakaszok.astro';

interface Props {
  elemzes: Elemzes;
  /** Ha ebben a fájlban nincs irányos trade terv (pl. frissítés), a nap korábbi fájljának terve. */
  tervTartalek?: TradeTerv | null;
}
const { elemzes, tervTartalek = null } = Astro.props;
const terv = elemzes.tradeTerv?.irany ? elemzes.tradeTerv : tervTartalek;
---

<div class="grid grid-cols-1 gap-4">
  <Osszkep elemzes={elemzes} />
  <HetFigyelmeztetes elemek={elemzes.hetFigyelmeztetes} />
  <Diagram azon={elemzes.id} datum={elemzes.datum} ablak={elemzes.ablak} szintek={elemzes.kulcsszintek} riasztasok={elemzes.riasztasok} figyeld={elemzes.figyeld} terv={terv} />
  <Kulcsszintek azon={elemzes.id} szintek={elemzes.kulcsszintek} riasztasok={elemzes.riasztasok} />
  <Forgatokonyvek lista={elemzes.forgatokonyvek} />
  <MeretKalkulator azon={elemzes.id} terv={elemzes.tradeTerv} />
  <Checklist elemek={elemzes.checklist} />
  <Szakaszok elemzes={elemzes} />
  {
    elemzes.figyelmeztetesek.length > 0 && (
      <aside class="rounded-xl border border-dashed border-line px-4 py-3 text-xs text-muted">
        <p class="font-medium">Ebből a fájlból nem sikerült kiolvasni:</p>
        <ul class="mt-1 list-disc pl-4">
          {elemzes.figyelmeztetesek.map((f) => (
            <li>{f}</li>
          ))}
        </ul>
      </aside>
    )
  }
</div>
