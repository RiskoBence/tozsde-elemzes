---
import type { Kulcsszint, Riasztas, SzintCsoport } from '../lib/parse-elemzes';

interface Props {
  szintek: Kulcsszint[];
  riasztasok: Riasztas[];
}
const { szintek, riasztasok } = Astro.props;

const csoportok: Record<SzintCsoport, { nev: string; sav: string; cimke: string }> = {
  celpont: { nev: 'Célpont', sav: 'bg-info', cimke: 'text-info bg-info-bg border-info-line' },
  poi: { nev: 'POI', sav: 'bg-poi', cimke: 'text-poi bg-poi-bg border-poi-line' },
  ervenytelenito: { nev: 'Érvénytelenítő', sav: 'bg-bad', cimke: 'text-bad bg-bad-bg border-bad-line' },
  egyeb: { nev: 'Egyéb', sav: 'bg-line', cimke: 'text-muted bg-panel-2 border-line' },
};
const hasznaltCsoportok = (Object.keys(csoportok) as SzintCsoport[]).filter((c) => szintek.some((s) => s.csoport === c));
---

{
  (szintek.length > 0 || riasztasok.length > 0) && (
    <section class="card" aria-label="Kulcsszintek">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 class="font-semibold">
          Kulcsszintek
        </h2>
        <p class="text-xs text-muted">Koppints egy árra a másoláshoz</p>
      </div>

      {riasztasok.length > 0 && (
        <div class="mt-3">
          <p class="text-xs font-medium uppercase tracking-wider text-muted">Riasztások</p>
          <ul class="mt-1.5 flex flex-wrap gap-2">
            {riasztasok.map((r) => (
              <li>
                <button
                  type="button"
                  data-masol={r.ar}
                  class="flex min-h-11 items-center gap-2 rounded-xl border border-warn-line bg-warn-bg px-3 text-left active:scale-[0.98]"
                >
                  <span aria-hidden="true">🔔</span>
                  <span class="font-mono font-semibold text-fg">{r.ar}</span>
                  {r.cimke && <span class="text-xs text-muted">{r.cimke}</span>}
                </button>
              </li>
            ))}
          </ul>
        </div>
      )}

      {szintek.length > 0 && (
        <ul class="mt-4 divide-y divide-line">
          {szintek.map((s) => (
            <li class="relative flex items-center gap-3 py-2 pl-3">
              <span aria-hidden="true" class:list={['absolute inset-y-1.5 left-0 w-1 rounded-full', csoportok[s.csoport].sav]} />
              <div class="min-w-0 flex-1">
                <p class="text-sm font-medium leading-snug">{s.szint}</p>
                <p class="mt-0.5 flex flex-wrap items-center gap-x-2 gap-y-0.5 text-xs text-muted">
                  <span class:list={['rounded border px-1.5 py-px font-medium', csoportok[s.csoport].cimke]}>{csoportok[s.csoport].nev}</span>
                  {s.megjegyzes && <span>{s.megjegyzes}</span>}
                </p>
              </div>
              <div class="flex shrink-0 flex-col items-end gap-1">
                {s.arak.length > 0 ? (
                  s.arak.map((ar) => (
                    <button
                      type="button"
                      data-masol={ar}
                      aria-label={`${ar} másolása`}
                      class="min-h-11 min-w-[6.5rem] rounded-lg border border-line bg-panel-2 px-2.5 text-right font-mono text-[0.95rem] font-semibold hover:border-accent active:scale-[0.98]"
                    >
                      {ar}
                    </button>
                  ))
                ) : (
                  <span class="font-mono">{s.ar}</span>
                )}
              </div>
            </li>
          ))}
        </ul>
      )}

      {hasznaltCsoportok.length > 1 && (
        <p class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-xs text-muted">
          {hasznaltCsoportok.map((c) => (
            <span class="inline-flex items-center gap-1.5">
              <span aria-hidden="true" class:list={['inline-block h-3 w-1 rounded-full', csoportok[c].sav]} />
              {csoportok[c].nev}
            </span>
          ))}
        </p>
      )}
    </section>
  )
}


<script>
  // Másoláskor a szóköz ezres elválasztó kimarad (a bróker beviteli mezője így fogadja),
  // a tizedesvessző marad. Ha pontot szeretnél: .replace(',', '.')
  const masolhato = (ar: string) => ar.replace(/[\s  ]/g, '');

  async function masol(szoveg: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(szoveg);
      return true;
    } catch {
      const ta = document.createElement('textarea');
      ta.value = szoveg;
      ta.setAttribute('readonly', '');
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      const ok = document.execCommand('copy');
      ta.remove();
      return ok;
    }
  }

  let idozito: number | undefined;
  document.addEventListener('click', async (ev) => {
    const gomb = (ev.target as Element | null)?.closest<HTMLElement>('[data-masol]');
    if (!gomb) return;
    const szoveg = masolhato(gomb.dataset.masol ?? '');
    const ok = await masol(szoveg);
    const uzenet = document.getElementById('masolas-uzenet');
    if (!uzenet) return;
    uzenet.textContent = ok ? `Másolva: ${szoveg}` : 'A másolás nem sikerült';
    uzenet.style.opacity = '1';
    window.clearTimeout(idozito);
    idozito = window.setTimeout(() => (uzenet.style.opacity = '0'), 1600);
  });
</script>
